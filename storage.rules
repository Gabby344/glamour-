rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos et vidéos visibles par tous ; envoi réservé à la gérante (60 Mo max)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'kabeluabigaelle@gmail.com' && request.resource.size < 60 * 1024 * 1024;
    }
  }
}
